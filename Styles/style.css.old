/* ---------- Base styles (all screen widths) ---------- */

html, body {
	margin: 0;
	padding: 0;
	background-color: #754974;
	font-family: 'Indie Flower', cursive;
	font-size: 1.2em;
	color: #FFF;
}

.main {
	overflow: hidden;
	margin: 0;
	padding: 0;
}

.bg1 {
	background-image: url("Images/bg1.jpg");
	background-position: center;
	background-size: cover;
	background-repeat: no-repeat;
	background-attachment: fixed;
	min-height: 100vh;
	min-height: 100svh;
	display: flex;
	align-items: center;
	justify-content: center;
}

.bg1 header {
	width: 100%;
}

.bg2 {
	background-image: url("Images/bg2-5.jpg");
	background-position: center;
	background-size: cover;
	background-repeat: no-repeat;
	background-attachment: fixed;
	min-height: 100vh;
	min-height: 100svh;
}

nav {
	text-align: right;
	padding-right: 50px;
	position: relative;
	font-size: 0.5em;
}

nav span {
	padding: 10px;
}

#avi {
display: block;
margin: auto;
border-radius: 20em;
max-width: 300px;
max-height: 300px;
}

.Hi {
	text-align: center;
	margin: auto;
	color: #C97581;
}

h1 {
	font-size: 2.5em;
}

section {
	padding: 50px;
	position: relative;
	max-width: 1000px;
	margin: 0 auto;
}

section img {
	width: 100%;
}

h2, h3 {
	margin: auto;
	padding: 0;
}

p {
	margin-top: 0;
}

a {
	text-decoration: none;
	color: #FFF;
	padding: 0;
	font-weight: 600;
	font-size: 1.5em;
}

footer {
	position: relative;
}

.social {
	text-align: center;
	margin: 0;
	padding: 0;
	border-style: none;
	background: none;
}

.social a {
	margin: 0;
	padding: 0;
}

/* Social icons (SVG used as a mask, colored via background-color) */
.social img {
	width: 20px;
	height: 20px;
	margin: 0 6px;
	filter: invert(1);
	transition: opacity .2s;
}

.social a:hover img {
	opacity: .7;
}

.inner {
	margin-top: 50px;
	margin-left: auto;
	margin-right: auto;
	display: block;
	width: 350px;
	padding: 5px 20px;
	height: 230px;
	border-radius: 1.5em;
	border-style: double;
	border-color: #FFF;
	background-color: rgba(117, 73, 116, 0.4);
	text-align: center;
}

.inner span {
	margin-top: 30px;
	margin-bottom: 30px;
	background-color: #754974;
	padding: 6px;
	border-radius: 5px;
}

.inner p {
	margin-top: 10px;
}



/* ---------- 700px and wider ---------- */

@media only screen and (min-width: 700px) {

	.bg2 {
		background-image: url("Images/bg2.jpg");
		background-attachment: fixed;
	}

	section img {
		width: auto;
		margin: auto;
		display: block;
	}

}


/* ---------- 1400px and wider ---------- */

@media only screen and (min-width: 1400px) {

	section img {
		position: absolute;
		top: 18%;
		right: 150px;
	}

}
